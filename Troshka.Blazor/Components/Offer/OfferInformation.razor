@code {
    [Parameter]
    public string Id { get; set; }

    private CarOfferModel _carOfferModel;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            var response = await OfferService.GetCarOfferAsync(Id);

            _carOfferModel = response.Value;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
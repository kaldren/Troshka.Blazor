@using AutoMapper;
@using Troshka.Blazor.Models.Offer.Car;
@using Troshka.Blazor.Models.Offer;

@inject IStringLocalizer<App> LocalizerContact

<div class="Components__Contact">
    @if (Model != default)
    {
        <RadzenCard class="m-3">
            <div class="d-flex flex-row p-3">
                <div>
                    <RadzenText TextStyle="TextStyle.Overline" class="d-flex mt-1 mb-0">@LocalizerContact["Contact_Author"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1"><b><a href="owners/@Model.Id" target="_blank">@Model.DisplayName</a></b></RadzenText>
                </div>
            </div>
            <RadzenCard class="my-3 rz-background-color-primary-lighter rz-shadow-0 rz-border-radius-0" style="margin: 0 calc(-1 * var(--rz-card-padding)); padding: 2rem;">
                <RadzenText TextStyle="TextStyle.H6" class="rz-color-primary-light"><strong>@LocalizerContact["Contact_InfoTitle"]</strong></RadzenText>
                <div class="row">
                    <RadzenText TextStyle="TextStyle.Overline" class="rz-color-primary-light d-flex mt-3 mb-0">@LocalizerContact["Contact_Phone"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1"><b>@Model.Phone</b></RadzenText>
                </div>
            </RadzenCard>
        </RadzenCard>
    }
</div>

@code {
    [Parameter]
    public OfferContactModel Model { get; set; }
}
@page "/my-offers"
@using Radzen.Blazor
@using Radzen;
@inject NavigationManager Navigation

<h3>Моите обяви</h3>

<p>В момента нямаш активни обяви.</p>

<RadzenButton Click=@(args => OnCreateOfferClick()) Text="Създай обява" ButtonStyle="ButtonStyle.Primary" />

@code {

    void OnCreateOfferClick()
    {
        Navigation.NavigateTo("create-offer");
    }

}

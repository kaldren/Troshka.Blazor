@page "/offer/{id}"
@using Radzen.Blazor
@using Radzen;
@using Troshka.Blazor.Components.Offer
@using Troshka.Blazor.Models.Offer.Car;
@using Troshka.Blazor.Models.Offer;
@using Troshka.Blazor.Services.Offer;

@inject NavigationManager Navigation
@inject IOfferService OfferService
@inject IStringLocalizer<App> Localizer

<div class="Pages__Offer">
    @if (_isLoading)
    {
        <p>@Localizer["Loading"]</p>
    }
    @if (_carOfferModel != null && _contactModel != null)
    {
        <main>
            <Options OfferId="@Id" />
            <Slideshow ImageUrls="@_carOfferModel.Images" />
            <OfferInformation Model="@_carOfferModel" />
            <Comments Id="@Id" />
        </main>
        <aside>
            <Contact Model="@_contactModel" />
        </aside>
    }
</div>

@code {

    [Parameter]
    public string Id { get; set; }

    private CarOfferModel _carOfferModel;
    private OfferContactModel _contactModel;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            var response = await OfferService.GetCarOfferAsync(Id);
            _carOfferModel = response.Value;
            _contactModel = new()
            {
                Id = _carOfferModel.AuthorId,
                Name = _carOfferModel.AuthorName,
                Email = _carOfferModel.AuthorEmail,
                Phone = _carOfferModel.AuthorPhone
            };
        }
        finally
        {
            _isLoading = false;
        }
    }
}

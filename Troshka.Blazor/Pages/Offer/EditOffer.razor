@page "/offer/{id}/edit"
@using Radzen.Blazor
@using Radzen;
@using Troshka.Blazor.Components.Offer
@using Troshka.Blazor.Configuration;
@using Troshka.Blazor.Models.Offer.Car;
@using Troshka.Blazor.Models.Offer;
@using Troshka.Blazor.Services.Category;
@using Troshka.Blazor.Services.Offer;

@inject NavigationManager Navigation
@inject IOfferService OfferService
@inject IStringLocalizer<App> Localizer
@inject ICategoryService CategoryService

<div class="Pages__EditOffer">
    @if (selectedType != null)
    {
        <DynamicComponent Type="@selectedType" Parameters="@_params" />
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; }

    [Parameter]
    public string VehicleType { get; set; }

    private Type? selectedType;

    private Dictionary<string, object> _params;

    protected override async Task OnInitializedAsync()
    {
        // Get offer type
        var category = await CategoryService.GetByOfferIdAsync(Id);

        if (category.Name == CategoryTypeConstants.Cars)
        {
            _params = new() { { "OfferId", Id }, };
            selectedType = Type.GetType("Troshka.Blazor.Components.Offer.Car.EditCarOfferComponent");
        }
    }
}
